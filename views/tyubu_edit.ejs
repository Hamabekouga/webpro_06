<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の編集</h2>
  <form action="/religion/2/tyubu/update/<%= data.id  %>" method="POST">
    <table>
      <tr><th>項目</th><th>データ</th></tr>
      <tr><td>県庁所在市</td><td><input type="text" name="capital" value="<%= data.capital %>"></td></tr>
      <tr><td>地方</td><td><input type="text" name="religion" value="<%= data.religion %>"></td></tr>
      <tr><td>人口</td><td><input type="text" name="population" value="<%= data.population %>"></td></tr>
      <tr><td>政令指定都市</td><td><input type="text" name="Gdcity" value="<%= data.Gdcity %>"></td></tr>
      <tr><td>地方中枢都市</td><td><input type="text" name="RCcity" value="<%= data.RCcity %>"></td></tr>
      <tr><td>名物</td><td><input type="text" name="fls" value="<%= data.fls %>"></td></tr>

      <% Object.keys(data).forEach(function(key) { %>
        <% 
          const List = ['id', 'name', 'capital', 'Gdcity', 'RCcity', 'fls', 'religion', 'population'];
          const NG = List.includes(key);
        %>
    
      <% if (NG == false) { %>
        
        <tr><td><label><%= key %> </label></td><td><input type="text" name="<%= key %>" value="<%= data[key] %>"></td></tr>

      <% } %>

    <% }); %>
    </table>
    <input type="submit" value="変更">
  </form>
  <a href="/religion/2/tyubu/<%= data.id %>">前のページに戻る</a>
</body>
</html>