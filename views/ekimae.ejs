<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>EKIMAE MALL</title>
</head>
<body>
  <h2>EKIMAE MALLの詳細</h2>
  <img src="/public/EKIMAE.png" alt="EKIMAE MALL" width="500"><br>
  <table>
    <tr><th>階数</th></tr>
      <% let number = 1 %>
      <% for( let row of data ) { %>
        <td><a href="/mall/2/EKIMAE/<%= number %>"><%= row.name %></a></td></tr>
        <% number += 1 %>
      <% } %>
  </table>
  <a href="/mall">モール選択に戻る</a>
</body>
</html>