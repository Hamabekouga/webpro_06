<!Doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title><%= data.name %></title>
</head>
<body>
  <h2><%= data.name %>の詳細</h2>
  <img src="/public/<%= data.name %>.png" alt="<%= data.name %>" width="400"><br>
  <table>
    <tr><td>県庁所在市</td><td><%= data.capital %></td></tr>
    <tr><td>地方</td><td><%= data.religion %></td></tr>
    <tr><td>人口</td><td><%= data.population %></td></tr>
    <tr><td>政令指定都市</td><td><%= data.Gdcity %></td></tr>
    <tr><td>地方中枢都市</td><td><%= data.RCcity %></td></tr>
    <tr><td>名物</td><td><%= data.fls %></td></tr>
    <% Object.keys(data).forEach(function(key) { %>
      <% 
        const List = ['id', 'name', 'capital', 'religion', 'population', 'Gdcity', 'RCcity', 'fls'];
        const NG = List.includes(key);
      %>

        <% if (NG == false) { %>

          <tr><td><%= key %></td><td><%= data[key] %></td></tr>

        <% } %>
    <% }); %>
  </table>
  <br><a href="/religion/4/sikoku/edit/<%= id %>">編集</a></br>
  <br><a href="/religion/4/sikoku/create/<%= id %>">追加</a></br>
  <br><a href="/religion/4/sikoku/delete/<%= id %>">削除</a></br>

  <a href="/religion/4">都道府県一覧に戻る</a>
</body>
</html>